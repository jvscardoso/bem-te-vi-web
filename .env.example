# URL base da bem-te-vi-api. Em dev, /api (proxy do Vite para http://localhost:3000): o cookie de
# refresh da sessão só funciona com a API na mesma origem do front (ver vite.config.ts).
VITE_API_URL=/api

# Em dev, a clínica vem do subdomínio de localhost: http://clinica-exemplo.localhost:5173
# (localhost puro = marca padrão / backoffice). Acessando por IP (celular na rede local), use
# ?tenant=clinica-exemplo na URL.

# Domínio base das clínicas em produção (ex.: bemtevi.com.br → clinica.bemtevi.com.br).
# Usado para mostrar o endereço da clínica em Configurações e no backoffice, e para separar os
# endereços da plataforma dos de clínica ("Endereço não encontrado"). Em produção, configure.
VITE_APP_BASE_DOMAIN=

# Endereços da plataforma (backoffice) fora do padrão, separados por vírgula. Já contam como da
# plataforma: o domínio base e www., app., admin., backoffice. e plataforma. dele.
VITE_PLATFORM_HOSTS=
