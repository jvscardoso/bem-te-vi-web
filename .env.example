# URL base da bem-te-vi-api
VITE_API_URL=http://localhost:3000

# Em dev (sem DNS), subdomínio usado para resolver a marca da clínica no login.
# Também pode ser passado na URL: http://localhost:5173/login?tenant=clinica-exemplo
# (`?tenant=` vazio esquece o tenant lembrado na aba).
VITE_DEV_TENANT=

# Domínio base das clínicas em produção (ex.: bemtevi.com.br → clinica.bemtevi.com.br).
# Usado para mostrar o endereço da clínica em Configurações e no backoffice.
VITE_APP_BASE_DOMAIN=
